{
  "name": "nishad-multiverse",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "preview": "npm run build && python3 tests/serve.py 8000 _site",
    "test": "node --test tests/*.test.mjs && playwright test",
    "test:syntax": "node tests/check-syntax.mjs",
    "test:blog": "node --test tests/blog.test.mjs && playwright test tests/blog.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "highlight.js": "11.11.1",
    "markdown-it": "15.0.2"
  }
}
