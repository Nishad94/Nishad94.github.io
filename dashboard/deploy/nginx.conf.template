# Render DOMAIN and COLLECTOR placeholders before installation.
limit_req_zone $binary_remote_addr zone=nishad_private:1m rate=5r/s;
limit_req_zone $binary_remote_addr zone=nishad_collect:1m rate=2r/s;
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}
server {
    listen 80;
    server_name DOMAIN COLLECTOR;
    access_log off;
    error_log /dev/null crit;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/nishad-acme; }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name DOMAIN;
    ssl_certificate /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 4k;
    client_body_buffer_size 8k;
    client_body_timeout 10s;
    send_timeout 15s;
    add_header Cache-Control "no-store" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    error_page 502 504 =503 @unavailable;
    location @unavailable {
        default_type text/plain;
        return 503 "Private metrics is unavailable. Owner setup or service recovery is required.\n";
    }
    location / {
        limit_req zone=nishad_private burst=30 nodelay;
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host DOMAIN;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_intercept_errors on;
        proxy_hide_header Cache-Control;
        proxy_hide_header Strict-Transport-Security;
    }
}
server {
    listen 443 ssl;
    server_name COLLECTOR;
    ssl_certificate /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 2k;
    client_body_buffer_size 8k;
    client_body_timeout 10s;
    send_timeout 15s;
    add_header Cache-Control "no-store" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location = /collect {
        limit_req zone=nishad_collect burst=10 nodelay;
        limit_except POST OPTIONS { deny all; }
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host COLLECTOR;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_hide_header Cache-Control;
        proxy_hide_header Strict-Transport-Security;
    }
    location / { return 404; }
}
