[Unit]
Description=Expire private metrics identifiers and aggregates
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=nishad-collect
Group=nishad-collect
LoadCredential=config:/etc/nishad-dashboard/maintain.json
ExecStart=/opt/nishad-dashboard/current/dashboard -config %d/config
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
LimitCORE=0
MemoryMax=128M
TasksMax=32
